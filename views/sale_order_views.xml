<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_force_customer_rank" model="ir.ui.view">
        <field name="name">sale.order.form.force.customer.rank</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="context">{'default_customer_rank': 1, 'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}</attribute>
            </field>
        </field>
    </record>

</odoo>